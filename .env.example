# LINE Developers の「Messaging API設定」「チャネル基本設定」から取得
LINE_CHANNEL_SECRET=ここにチャネルシークレット
LINE_CHANNEL_ACCESS_TOKEN=ここにチャネルアクセストークン(長期)

# LINEで「管理者登録 <このパスコード>」と送ると管理者になれます
ADMIN_PASSCODE=好きな合言葉に変更してください

# ブラウザでシフト表を見るときの合言葉 (/shifts?token=...)
WEB_TOKEN=好きな合言葉に変更してください

PORT=8000
SHIFTBOT_DB=shiftbot.db
SHIFTBOT_CONFIG=config.json
